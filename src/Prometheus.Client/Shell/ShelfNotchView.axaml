<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Prometheus.Client.Shell.ShelfNotchView">
    <!-- CÁPSULA FLOTANTE TIPO GOTA / DYNAMIC ISLAND ELEVADA (SOLO PANELES Y MINIMIZADOS) -->
    <Border Name="NotchPillBorder"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#121212"
            BorderBrush="{StaticResource BorderCapsuleBrush}"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,14,14"
            Padding="12,3,12,5"
            BoxShadow="0 4 20 2 #99000000">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <!-- MENÚ DIRECTO DE PANELES (SIN SUBMENÚS) -->
            <Menu VerticalAlignment="Center">
                <MenuItem Name="PanelesMenuHeader" Header="Paneles ▾" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource BackgroundSurfaceSecondaryBrush}" CornerRadius="4" Padding="10,4">
                    <MenuItem Name="MenuMediaPool" />
                    <MenuItem Name="MenuMonitor" />
                    <MenuItem Name="MenuTimeline" />
                    <MenuItem Name="MenuProperties" />
                    <MenuItem Name="MenuEffects" />
                    <MenuItem Name="MenuTranscript" />
                    <MenuItem Name="MenuInstructions" />
                    <MenuItem Name="MenuAudioMixer" />
                    <MenuItem Name="MenuColor" />
                </MenuItem>
            </Menu>

            <!-- ESTANTE DINÁMICO DE PANELES MINIMIZADOS (CRECE EN ANCHO) -->
            <StackPanel Name="MinimizedShelfSection" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="False">
                <Separator Width="1" Height="14" Background="{StaticResource BorderSubtleBrush}" Margin="2,0" />
                <ItemsControl Name="MinimizedShelfItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
