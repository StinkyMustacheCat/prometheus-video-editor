<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Prometheus.Client.Docking.DockPanelHostControl"
             MinWidth="120" MinHeight="80">
    <Border Name="HostOuterBorder" Background="{StaticResource BackgroundPanelBaseBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
        <Grid RowDefinitions="28,*">
            <!-- CABECERA DEL PANEL (BARRA DE TÍTULO Y GESTOS) -->
            <Border Grid.Row="0" Name="HeaderBorder" Background="{StaticResource BackgroundPanelHeaderBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="8,0,4,0" Cursor="SizeAll">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <!-- INDICADOR DE ACENTO NARANJA PROMETHEUS -->
                    <Border Grid.Column="0" Width="3" Height="14" Background="{StaticResource PrometheusOrangeBrush}" CornerRadius="1" Margin="0,0,6,0" VerticalAlignment="Center" />

                    <!-- TÍTULO DEL PANEL (DRAGGABLE) -->
                    <TextBlock Grid.Column="1" Name="TitleTextBlock" Text="Panel" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2" Name="SequenceHeaderSlot" HorizontalAlignment="Center" IsVisible="False" />

                    <!-- BOTONES DE ACCIÓN: HAMBURGUESA ☰, MINIMIZAR ➖, CERRAR ✕ -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <!-- MENÚ HAMBURGUESA -->
                        <Button Name="HamburgerButton" Classes="nle-btn" ToolTip.Tip="Opciones del panel" Width="22" Height="20" Padding="0">
                            <TextBlock Text="☰" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button.ContextMenu>
                                <ContextMenu Name="PanelContextMenu">
                                    <MenuItem Name="MenuFloatOption" Header="Desacoplar a panel flotante" />
                                    <MenuItem Name="MenuMinimizeOption" Header="Minimizar al Estante" />
                                    <MenuItem Name="MenuReplaceOption" Header="Reemplazar panel" />
                                    <Separator />
                                    <MenuItem Name="MenuCloseOption" Header="Cerrar panel" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        
                        <!-- BOTÓN CERRAR DIRECTO -->
                        <Button Name="CloseButton" Classes="nle-btn" ToolTip.Tip="Cerrar panel" Width="20" Height="20" Padding="0">
                            <TextBlock Text="✕" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        
                        <!-- BOTÓN MINIMIZAR DIRECTO -->
                        <Button Name="MinimizeButton" Classes="nle-btn" ToolTip.Tip="Minimizar al Estante" Width="20" Height="20" Padding="0">
                            <TextBlock Text="➖" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENIDO DEL PANEL -->
            <Border Grid.Row="1" Name="ContentContainer" Background="{StaticResource BackgroundPanelBaseBrush}" />
        </Grid>
    </Border>
</UserControl>
