<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Prometheus.Client.Docking.FloatingPanelCardControl"
             MinWidth="220" MinHeight="160">
    <!-- CONTENEDOR FLOTANTE ELEVADO CON SOMBRA Y BORDES REDONDEADOS -->
    <Border Name="CardRoot"
            Background="{StaticResource BackgroundPanelBaseBrush}"
            BorderBrush="{StaticResource BorderFocusedBrush}"
            BorderThickness="1"
            CornerRadius="8"
            BoxShadow="0 8 24 4 #66000000">
        <Grid RowDefinitions="28,*,Auto">
            <!-- CABECERA DE PANEL FLOTANTE (DRAGGABLE) -->
            <Border Grid.Row="0" Name="HeaderBorder" Background="{StaticResource BackgroundPanelHeaderBrush}" CornerRadius="8,8,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="8,0,4,0" Cursor="SizeAll">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <!-- ICONO DE IDENTIDAD Y TÍTULO -->
                    <Image Grid.Column="0" Source="/Assets/app.ico" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Name="TitleText" Text="Panel Flotante" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2" Name="SequenceHeaderSlot" HorizontalAlignment="Center" IsVisible="False" />

                    <!-- ACCIONES: CERRAR, MINIMIZAR -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Name="CloseButton" Classes="nle-btn" ToolTip.Tip="Cerrar panel" Width="20" Height="20" Padding="0">
                            <TextBlock Text="✕" FontSize="10" />
                        </Button>
                        <Button Name="MinimizeButton" Classes="nle-btn" ToolTip.Tip="Minimizar al Estante" Width="20" Height="20" Padding="0">
                            <TextBlock Text="➖" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENIDO INTERNO DEL PANEL -->
            <Border Grid.Row="1" Name="ContentContainer" Background="{StaticResource BackgroundPanelBaseBrush}" ClipToBounds="True" />

            <!-- TIRADOR DE REDIMENSIONAMIENTO INFERIOR DERECHO -->
            <Border Grid.Row="2" Height="6" Background="Transparent">
                <Border Name="ResizeHandle" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" Margin="0,-8,0,0">
                    <Path Data="M 12,2 L 12,12 L 2,12 Z" Fill="{StaticResource BorderFocusedBrush}" Opacity="0.7" />
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>
