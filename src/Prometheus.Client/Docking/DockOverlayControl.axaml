<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Prometheus.Client.Docking.DockOverlayControl"
             IsHitTestVisible="False">
    <Panel Name="OverlayRoot">
        <!-- CANALES PERIMETRALES DE 8 PX (EDGE GUTTERS) -->
        <Border Name="GutterLeft" HorizontalAlignment="Left" Width="8" Background="Transparent" />
        <Border Name="GutterTop" VerticalAlignment="Top" Height="8" Background="Transparent" />
        <Border Name="GutterRight" HorizontalAlignment="Right" Width="8" Background="Transparent" />
        <Border Name="GutterBottom" VerticalAlignment="Bottom" Height="8" Background="Transparent" />

        <!-- LIENZO FLUIDO PARA RECUADRO INDICADOR Y GHOST CARD -->
        <Canvas Name="OverlayCanvas">
            <!-- RECUADRO INDICADOR DE DESTINO DE ACOPLE -->
            <Border Name="DropPreviewBorder"
                    IsVisible="False"
                    Background="{StaticResource PrometheusOrangeAuraBrush}"
                    BorderBrush="{StaticResource PrometheusOrangeHoverBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    BoxShadow="0 0 20 2 #40FF8A00">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#E6121212"
                        BorderBrush="{StaticResource PrometheusOrangeBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14,6"
                        BoxShadow="0 4 12 2 #88000000">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource PrometheusOrangeBrush}" VerticalAlignment="Center" />
                        <TextBlock Name="DropFeedbackText"
                                   Text="Acoplar"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- TARJETA FANTASMA QUE SIGUE AL CURSOR -->
            <Border Name="DragGhostCard"
                    IsVisible="False"
                    Width="160" Height="36"
                    Background="#E6141414"
                    BorderBrush="{StaticResource PrometheusOrangeBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,4"
                    BoxShadow="0 8 20 2 #99000000">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="3" Height="14" Background="{StaticResource PrometheusOrangeBrush}" CornerRadius="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Name="DragGhostText" Text="Panel" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Name="DragGhostMode" Text="⇲" FontSize="10" Foreground="{StaticResource PrometheusOrangeHoverBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                </Grid>
            </Border>
        </Canvas>
    </Panel>
</UserControl>
