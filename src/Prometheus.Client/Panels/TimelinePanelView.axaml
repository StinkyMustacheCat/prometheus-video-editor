<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:timeline="using:Prometheus.Client.Timeline"
             x:Class="Prometheus.Client.Panels.TimelinePanelView"
             MinWidth="900" MinHeight="270">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{StaticResource BackgroundPureBlackBrush}">
        <!-- 1. BARRA DE HERRAMIENTAS EDITORIALES -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundPanelHeaderBrush}" Padding="8,4" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Herramientas de edición -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button Name="ToolVBtn" Classes="nle-accent" ToolTip.Tip="Selección (V) - Mover, Trim y Roll" Width="36" Height="24" Padding="0" />
                    <Button Name="ToolCBtn" Classes="nle-btn" ToolTip.Tip="Cuchilla (C) - Corte simple o arrastre de área" Width="36" Height="24" Padding="0" />
                    <Button Name="ToolABtn" Classes="nle-btn" ToolTip.Tip="Selección direccional (A)" Width="36" Height="24" Padding="0" />
                    <Button Name="ToolTextBtn" Classes="nle-btn" Width="36" Height="24" Padding="0" />
                    <Button Name="ToolHBtn" Classes="nle-btn" ToolTip.Tip="Desplazar línea de tiempo (H)" Width="36" Height="24" Padding="0" />
                    <Button Name="ToolZBtn" Classes="nle-btn" ToolTip.Tip="Zoom (Z) - Izquierdo: ampliar | Derecho: reducir" Width="36" Height="24" Padding="0" />
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Button Name="ToolSamBtn" Classes="nle-btn" ToolTip.Tip="Máscara (G)" Width="32" Height="24" Padding="0" />
                        <Button Name="ToolMaskMenuBtn" Classes="nle-btn" Content="▾" ToolTip.Tip="Elegir forma de máscara o SAM" Width="18" Height="24" Padding="0" />
                    </StackPanel>
                </StackPanel>

                <!-- TÍTULO DE SECUENCIA Y TIMECODE MAESTRO 60 FPS -->
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto,*" VerticalAlignment="Center">
                    <Button Grid.Column="1" Name="SubtitleLaneBtn" Classes="nle-btn" Height="24" Padding="8,0"
                            MinWidth="72" Margin="6,0,14,0" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Desplegar o plegar la pista de subtítulos"
                            AutomationProperties.Name="Pista de subtítulos">
                        <TextBlock Text="Pista&#10;subtítulos" TextAlignment="Center" FontSize="10" LineHeight="11" />
                    </Button>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Name="PlayPauseBtn" Classes="nle-btn" Width="26" Height="24" Padding="0" ToolTip.Tip="Reproducir / Pausa (Barra Espaciadora)" />
                    <Border Name="TimecodeHost" Background="{StaticResource BackgroundSurfaceSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" ToolTip.Tip="Clic para ir a un fotograma exacto">
                        <TextBlock Name="TimecodeDisplay" Text="00:00:00:00" FontFamily="Consolas, monospace" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrometheusOrangeBrush}" />
                    </Border>
                    <ToggleButton Name="LoopToggle" Content="∞" Width="26" Height="24" Padding="0" ToolTip.Tip="Repetir montaje al terminar" />
                    <ComboBox Name="PreviewSpeedBox" SelectedIndex="2" Width="70" Height="24" ToolTip.Tip="Velocidad de previsualización">
                        <ComboBoxItem Content="×0.5" /><ComboBoxItem Content="×0.75" /><ComboBoxItem Content="×1" />
                        <ComboBoxItem Content="×1.25" /><ComboBoxItem Content="×1.5" /><ComboBoxItem Content="×2" /><ComboBoxItem Content="×3" />
                    </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- CONTROL DE ZOOM FLUIDO -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ToggleButton Name="SnapToggle" IsChecked="True" Width="26" Height="24" Padding="0" ToolTip.Tip="Encaje magnético (S)" />
                    <TextBlock Text="Zoom:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Slider Name="ZoomSlider" Width="100" Minimum="0.1" Maximum="1000" Value="40" VerticalAlignment="Center" />
                    <Button Name="FitContentButton" Classes="nle-btn" Content="Ajustar todo" Height="24" Padding="5,0" ToolTip.Tip="Mostrar todo el contenido" />
                    <Button Name="FitSelectionButton" Classes="nle-btn" Content="Ajustar selección" Height="24" Padding="5,0" ToolTip.Tip="Mostrar solo la selección" />
                    <Button Name="TimelineSettingsButton" Width="27" Height="24" Padding="0" ToolTip.Tip="Configuración de línea de tiempo" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. REGLA DE TIEMPO INTERACTIVA CON SCRUBBING -->
        <Border Grid.Row="1" Height="22" Background="#141414" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Name="RulerGrid" ColumnDefinitions="150,*">
                <Border Grid.Column="0" Background="#121212" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                        <Button Name="AddTrackBtn" Classes="nle-btn" Content="+ Pista" ToolTip.Tip="Añadir pista de vídeo o audio" Height="20" Padding="5,0" />
                        <Button Name="CompactTrackHeaderBtn" Classes="nle-btn" Content="‹" ToolTip.Tip="Reducir cabeceras de pistas" Width="21" Height="20" Padding="0" />
                    </StackPanel>
                </Border>
                <Canvas Grid.Column="1" Name="RulerCanvas" Background="#141414" Cursor="Hand" ClipToBounds="True">
                    <!-- CABEZAL TRIANGULAR INDICADOR DE REGLA -->
                    <Polygon Name="PlayheadHead" Canvas.Left="-6" Canvas.Top="0" Points="0,0 12,0 6,10" Fill="{StaticResource PrometheusOrangeBrush}" Cursor="SizeWestEast" />
                </Canvas>
            </Grid>
        </Border>

        <!-- 3. PISTAS Y LIENZO VIRTUALIZADO SKIA -->
        <Grid Grid.Row="2" Name="TrackBodyGrid" ColumnDefinitions="150,*">
            <!-- CABECERAS DE PISTAS (TRACK HEADERS) -->
            <Border Grid.Column="0" Background="#0C0C0C" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Canvas Name="TrackHeaderPanel" ClipToBounds="True" />
            </Border>

            <!-- LIENZO DE CLIPS VIRTUALIZADO SKIA -->
            <Grid Grid.Column="1" ClipToBounds="True">
            <timeline:TimelineCanvasControl
                                            Name="TimelineCanvas"
                                            Focusable="True"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" />
            <Border Name="PlayheadLine" Width="2" HorizontalAlignment="Left"
                    Background="{StaticResource PrometheusOrangeBrush}" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
            </Border>
            <Canvas Name="NestedInlineOverlay" IsHitTestVisible="True" ClipToBounds="True" />
            <Canvas Name="TrackScrollOverlay" Width="8" HorizontalAlignment="Right" IsHitTestVisible="True" />
            </Grid>
        </Grid>

        <!-- 4. BARRA DE DESPLAZAMIENTO / MINIMAPA INFERIOR DE PREVISUALIZACIÓN -->
        <Border Grid.Row="3" Background="#121212" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid Name="OverviewGrid" ColumnDefinitions="150,*">
                <Border Grid.Column="0" Background="#0C0C0C" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="6,0">
                    <TextBlock Text="NAVIGATOR" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <timeline:TimelineOverviewControl Grid.Column="1" Name="OverviewScrollBar" HorizontalAlignment="Stretch" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

