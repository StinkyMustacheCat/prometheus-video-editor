<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Prometheus.Client.Panels.AudioMixerPanelView">
    <Grid RowDefinitions="Auto,*" Background="{StaticResource BackgroundPureBlackBrush}">
        <Border Background="{StaticResource BackgroundPanelHeaderBrush}" Padding="8,6" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="MEZCLADOR DE AUDIO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="8">
            <StackPanel Name="ChannelPanel" Orientation="Horizontal" Spacing="10" />
        </ScrollViewer>
    </Grid>
</UserControl>
