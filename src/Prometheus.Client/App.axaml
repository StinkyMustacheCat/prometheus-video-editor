<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Prometheus.Client.App"
             xmlns:local="using:Prometheus.Client"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- PALETA PROMETHEUS V2 -->
        <Color x:Key="PrometheusOrange">#FF8A00</Color>
        <Color x:Key="PrometheusOrangeHover">#FFA126</Color>
        <Color x:Key="PrometheusOrangePressed">#D96F00</Color>
        <Color x:Key="PrometheusOrangeAura">#26FF8A00</Color>
        <Color x:Key="PrometheusOrangeGlow">#80FF8A00</Color>

        <!-- FONDOS Y SUPERFICIES (NEGRO PURO DOMINANTE) -->
        <Color x:Key="BackgroundPureBlack">#000000</Color>
        <Color x:Key="BackgroundCapsuleBase">#101010</Color>
        <Color x:Key="BackgroundPanelBase">#080808</Color>
        <Color x:Key="BackgroundPanelHeader">#121212</Color>
        <Color x:Key="BackgroundSurfaceSecondary">#181818</Color>
        <Color x:Key="BackgroundSurfaceTertiary">#222222</Color>

        <!-- BORDES Y NEUTROS -->
        <Color x:Key="BorderSubtle">#1A1A1A</Color>
        <Color x:Key="BorderCapsule">#242424</Color>
        <Color x:Key="BorderFocused">#383838</Color>

        <!-- TEXTO -->
        <Color x:Key="TextPrimary">#F4F4F4</Color>
        <Color x:Key="TextSecondary">#8E8E8E</Color>
        <Color x:Key="TextMuted">#555555</Color>

        <!-- SOLID COLOR BRUSHES -->
        <SolidColorBrush x:Key="PrometheusOrangeBrush" Color="{StaticResource PrometheusOrange}" />
        <SolidColorBrush x:Key="PrometheusOrangeHoverBrush" Color="{StaticResource PrometheusOrangeHover}" />
        <SolidColorBrush x:Key="PrometheusOrangePressedBrush" Color="{StaticResource PrometheusOrangePressed}" />
        <SolidColorBrush x:Key="PrometheusOrangeAuraBrush" Color="{StaticResource PrometheusOrangeAura}" />
        <SolidColorBrush x:Key="PrometheusOrangeGlowBrush" Color="{StaticResource PrometheusOrangeGlow}" />

        <SolidColorBrush x:Key="BackgroundPureBlackBrush" Color="{StaticResource BackgroundPureBlack}" />
        <SolidColorBrush x:Key="BackgroundCapsuleBaseBrush" Color="{StaticResource BackgroundCapsuleBase}" />
        <SolidColorBrush x:Key="BackgroundPanelBaseBrush" Color="{StaticResource BackgroundPanelBase}" />
        <SolidColorBrush x:Key="BackgroundPanelHeaderBrush" Color="{StaticResource BackgroundPanelHeader}" />
        <SolidColorBrush x:Key="BackgroundSurfaceSecondaryBrush" Color="{StaticResource BackgroundSurfaceSecondary}" />
        <SolidColorBrush x:Key="BackgroundSurfaceTertiaryBrush" Color="{StaticResource BackgroundSurfaceTertiary}" />

        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />
        <SolidColorBrush x:Key="BorderCapsuleBrush" Color="{StaticResource BorderCapsule}" />
        <SolidColorBrush x:Key="BorderFocusedBrush" Color="{StaticResource BorderFocused}" />

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />

        <!-- FLUENT THEME RESOURCE OVERRIDES PARA SLIDERS NATIVOS ESTABLES -->
        <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource PrometheusOrange}" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource PrometheusOrangeHover}" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource PrometheusOrangePressed}" />
        <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource PrometheusOrange}" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{StaticResource PrometheusOrangeHover}" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{StaticResource PrometheusOrangePressed}" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        
        <!-- ESTILO GLOBAL PARA VENTANA -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource BackgroundPureBlackBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Inter, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif" />
        </Style>

        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{StaticResource BackgroundPureBlackBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Background" Value="{StaticResource BackgroundPureBlackBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <!-- BOTONES MINIMALISTAS TIPO NLE -->
        <Style Selector="Button.nle-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nle-btn:pointerover">
            <Setter Property="Background" Value="{StaticResource BackgroundSurfaceSecondaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrometheusOrangeHoverBrush}" />
        </Style>
        <Style Selector="Button.nle-btn:pressed">
            <Setter Property="Background" Value="{StaticResource BackgroundSurfaceTertiaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrometheusOrangeBrush}" />
        </Style>

        <!-- BOTONES DE ACENTO NARANJA PROMETHEUS -->
        <Style Selector="Button.nle-accent">
            <Setter Property="Background" Value="{StaticResource PrometheusOrangeBrush}" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nle-accent:pointerover">
            <Setter Property="Background" Value="{StaticResource PrometheusOrangeHoverBrush}" />
        </Style>
        <Style Selector="Button.nle-accent:pressed">
            <Setter Property="Background" Value="{StaticResource PrometheusOrangePressedBrush}" />
        </Style>

        <!-- BOTONES DEL SHELF NOTCH (32x30 px) -->
        <Style Selector="Button.shelf-btn">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource BackgroundSurfaceSecondaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.shelf-btn:pointerover">
            <Setter Property="Background" Value="{StaticResource BackgroundSurfaceTertiaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrometheusOrangeHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrometheusOrangeBrush}" />
        </Style>
        <Style Selector="Button.shelf-btn:pressed">
            <Setter Property="Background" Value="{StaticResource BackgroundPureBlackBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrometheusOrangePressedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrometheusOrangePressedBrush}" />
        </Style>

        <!-- SLIDERS NATIVOS FLUIDOS SIN TITILEO -->
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{StaticResource PrometheusOrangeBrush}" />
        </Style>
        <Style Selector="Slider /template/ Track#PART_Track">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- TOGGLE BUTTONS EN NARANJA PROMETHEUS -->
        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="{StaticResource BackgroundSurfaceSecondaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton:checked">
            <Setter Property="Background" Value="{StaticResource PrometheusOrangeBrush}" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderBrush" Value="{StaticResource PrometheusOrangeHoverBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ToggleButton:checked:pointerover">
            <Setter Property="Background" Value="{StaticResource PrometheusOrangeHoverBrush}" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>

        <!-- CHECKBOXES EN NARANJA PROMETHEUS -->
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{StaticResource PrometheusOrangeBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrometheusOrangeBrush}" />
        </Style>
        <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{StaticResource PrometheusOrangeHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrometheusOrangeHoverBrush}" />
        </Style>

        <!-- ESTILO CÁPSULA TIPO CHAT (CARDS REDONDEADAS) -->
        <Style Selector="Border.capsule">
            <Setter Property="Background" Value="{StaticResource BackgroundCapsuleBaseBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderCapsuleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style Selector="Border.capsule.inspector-card">
            <Setter Property="Background" Value="#101010" />
            <Setter Property="BorderBrush" Value="#303030" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- TOOLTIPS OSCUROS CON BORDE NARANJA SUTIL -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{StaticResource BackgroundSurfaceSecondaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrometheusOrangeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Application.Styles>
</Application>
