{
  "type": "object",
  "properties": {
    "format": {
      "const": "prometheus-project"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "active_sequence_id": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "sequences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sequence"
      },
      "minItems": 1
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension"
      }
    }
  },
  "required": [
    "format",
    "schema_version",
    "id",
    "name",
    "revision",
    "active_sequence_id",
    "assets",
    "sequences",
    "extensions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "rational": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "d": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "n",
        "d"
      ],
      "additionalProperties": false
    },
    "extension": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "namespace",
        "version",
        "payload"
      ],
      "additionalProperties": false
    },
    "stream": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "image"
          ]
        },
        "codec": {
          "type": "string",
          "minLength": 1
        },
        "pts_origin": {
          "$ref": "#/$defs/rational"
        },
        "time_base": {
          "$ref": "#/$defs/rational"
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/rational"
            },
            {
              "type": "null"
            }
          ]
        },
        "nominal_fps": {
          "anyOf": [
            {
              "$ref": "#/$defs/rational"
            },
            {
              "type": "null"
            }
          ]
        },
        "sample_rate": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "channels": {
          "anyOf": [
            {
              "enum": [
                1,
                2
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "ordinal",
        "kind",
        "codec",
        "pts_origin",
        "time_base",
        "duration",
        "nominal_fps",
        "sample_rate",
        "channels"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "relative": {
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "relative"
          ],
          "additionalProperties": false
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "presentation_origin": {
          "$ref": "#/$defs/rational"
        },
        "streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stream"
          },
          "minItems": 1
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          }
        }
      },
      "required": [
        "id",
        "name",
        "locator",
        "sha256",
        "presentation_origin",
        "streams",
        "extensions"
      ],
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "video",
            "audio"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "enabled": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "gain_db": {
          "type": "number",
          "minimum": -60,
          "maximum": 12
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "order",
        "enabled",
        "locked",
        "gain_db"
      ],
      "additionalProperties": false
    },
    "clip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "stream_id": {
          "type": "string",
          "minLength": 1
        },
        "timeline_start": {
          "$ref": "#/$defs/rational"
        },
        "duration": {
          "$ref": "#/$defs/rational"
        },
        "source_in": {
          "$ref": "#/$defs/rational"
        },
        "speed": {
          "$ref": "#/$defs/rational"
        },
        "enabled": {
          "type": "boolean"
        },
        "gain_db": {
          "type": "number",
          "minimum": -60,
          "maximum": 12
        },
        "effects": {
          "type": "array",
          "maxItems": 0
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          }
        }
      },
      "required": [
        "id",
        "name",
        "track_id",
        "asset_id",
        "stream_id",
        "timeline_start",
        "duration",
        "source_in",
        "speed",
        "enabled",
        "gain_db",
        "effects",
        "extensions"
      ],
      "additionalProperties": false
    },
    "sequence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fps": {
          "$ref": "#/$defs/rational"
        },
        "color_space": {
          "const": "rec709-sdr"
        },
        "mix_sample_rate": {
          "const": 48000
        },
        "mix_channels": {
          "const": 2
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clip"
          }
        },
        "link_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "clip_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "clip_ids"
            ],
            "additionalProperties": false
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          }
        }
      },
      "required": [
        "id",
        "name",
        "width",
        "height",
        "fps",
        "color_space",
        "mix_sample_rate",
        "mix_channels",
        "tracks",
        "clips",
        "link_groups",
        "extensions"
      ],
      "additionalProperties": false
    }
  },
  "title": "Prometheus experimental project 0.1.0",
  "description": "Structure only. Semantic rules in PROMETHEUS-0.1.md are mandatory."
}
